{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diffy-s1-monaco",
  "version": "0.0.0",
  "identifier": "dev.diffy.prototype.s1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Diffy S1 prototype (Q41)", "width": 1400, "height": 900 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
